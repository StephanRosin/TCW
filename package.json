{
  "name": "tcw-spielbetrieb",
  "version": "1.0.0",
  "private": true,
  "description": "TCW Spielbetrieb 2026 – Interclub- und Turnier-Webseite des TC Waidberg (Neubau)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/shared",
    "packages/core",
    "packages/tournament-ui",
    "apps/public-server",
    "apps/admin-server",
    "apps/web-public",
    "apps/web-admin",
    "apps/waidcup-server",
    "apps/waidcup-public"
  ],
  "scripts": {
    "migrate": "tsx scripts/migrate.ts",
    "migrate:drop-redundant": "tsx scripts/drop-redundant-columns.ts",
    "import:live": "tsx scripts/import-live-snapshot.ts",
    "refresh:tournaments": "tsx scripts/refresh-tournaments.ts",
    "backfill:player-matches": "tsx scripts/backfill-player-matches.ts",
    "backfill:player-registry": "tsx scripts/backfill-player-registry.ts",
    "import:agenda": "tsx scripts/import-agenda.ts",
    "dev": "concurrently -n public-api,admin-api,public-web,admin-web -c blue,magenta,green,yellow \"npm:dev:public-api\" \"npm:dev:admin-api\" \"npm:dev:public-web\" \"npm:dev:admin-web\"",
    "dev:public-api": "npm -w @tcw/public-server run dev",
    "dev:admin-api": "npm -w @tcw/admin-server run dev",
    "dev:public-web": "npm -w @tcw/web-public run dev",
    "dev:admin-web": "npm -w @tcw/web-admin run dev",
    "build": "npm -w @tcw/web-public run build && npm -w @tcw/web-admin run build && npm -w @tcw/waidcup-public run build",
    "typecheck": "tsc -b packages/shared packages/core && tsc -p packages/tournament-ui",
    "lint": "eslint .",
    "test": "npm -w @tcw/shared run test && npm -w @tcw/core run test && npm -w @tcw/tournament-ui run test",
    "dev:waidcup": "concurrently -n waidcup-api,waidcup-web -c cyan,white \"npm:dev:waidcup-api\" \"npm:dev:waidcup-web\"",
    "dev:waidcup-api": "npm -w @tcw/waidcup-server run dev",
    "dev:waidcup-web": "npm -w @tcw/waidcup-public run dev",
    "seed:waidcup-test": "tsx scripts/seed-waidcup-test-data.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^9.1.0",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.62.0"
  }
}
